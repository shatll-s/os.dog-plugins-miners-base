#!/bin/bash
set -euo pipefail

PROFILE="${1:-}"
[[ -n "$PROFILE" && -f "$PROFILE" ]] || { echo "Usage: $0 <profile.json>"; exit 1; }
API_PORT=$(jq -r '.api_port // empty' "$PROFILE")
[[ "$API_PORT" =~ ^[0-9]+$ ]] || exit 1
curl --fail --silent --noproxy '*' --connect-timeout 2 --max-time 5 "http://127.0.0.1:$API_PORT/" |
jq -ce --argjson now "$(date +%s)" '
  def hexbus:
    tonumber | . as $bus | "0123456789abcdef" as $hex |
    $hex[($bus / 16 | floor):(($bus / 16 | floor) + 1)] + $hex[($bus % 16):(($bus % 16) + 1)];
  select(.version != null and .algos[0] != null) |
  {miner: "onezerominer", ver: .version, algo: .algos[0].name,
   online: ($now - (.uptime_seconds // 0)),
   total_hr: ((.algos[0].total_hashrate // 0) | tostring),
   total_share: ((.algos[0].total_accepted_shares // 0) | tostring),
   total_badshare: (((.algos[0].total_rejected_shares // 0) + (.algos[0].total_invalid_shares // 0)) | tostring),
   hr: (.algos[0].hashrates // []),
   share: (.algos[0].devices_accepted_shares // []),
   badshare: (.algos[0].devices_rejected_shares // []),
   busid: ([.devices[]?.bus_id | hexbus] |
     to_entries | map({key: (.key | tostring), value: .value}) | from_entries)} +
   (if all(.devices[]?; .temp != null) then {temp: [.devices[].temp]} else {} end) +
   (if all(.devices[]?; .fan != null) then {fan: [.devices[].fan]} else {} end)
'
