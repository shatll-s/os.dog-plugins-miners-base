#!/bin/bash
set -euo pipefail

PROFILE="${1:-}"
[[ -n "$PROFILE" && -f "$PROFILE" ]] || { echo "Usage: $0 <profile.json>"; exit 1; }
API_PORT=$(jq -r '.api_port // empty' "$PROFILE")
[[ "$API_PORT" =~ ^[0-9]+$ ]] || exit 1
# /status includes the binary version and has per-device arrays for each
# algorithm. os.dog's slot stats describe the first configured algorithm.
curl --fail --silent --noproxy '*' --connect-timeout 2 --max-time 5 "http://127.0.0.1:$API_PORT/status" |
jq -ce --argjson now "$(date +%s)" '
  select(.bzminer_version != null and (.devices | type) == "array") |
  . as $raw | [.devices[] | select(.vendor != 4)] as $gpus |
  {miner: "bzminer", ver: (.bzminer_version | ltrimstr("v")),
   algo: (.pools[0].algorithm // ""), online: ($now - (.uptime_s // 0)),
   total_hr: ([.devices[].hashrate[0] // 0] | add // 0 | tostring),
   total_share: ([.devices[].valid_solutions[0] // 0] | add // 0 | tostring),
   total_badshare: ([.devices[] | ((.invalid_solutions[0] // 0) + (.rejected_solutions[0] // 0))] | add // 0 | tostring),
   hr: [$gpus[].hashrate[0] // 0],
   share: [$gpus[].valid_solutions[0] // 0],
   badshare: [$gpus[] | ((.invalid_solutions[0] // 0) + (.rejected_solutions[0] // 0))],
   temp: [$gpus[].core_temp // 0], fan: [$gpus[].fan // 0],
   busid: ($gpus | to_entries | map({key: (.key | tostring), value:
     (.value.pci_bus_id | tonumber | . as $bus |
      "0123456789abcdef" as $hex |
      $hex[($bus / 16 | floor):(($bus / 16 | floor) + 1)] + $hex[($bus % 16):(($bus % 16) + 1)])}) | from_entries)}
'
