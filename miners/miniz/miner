#!/bin/bash
####################################################################################
###
### miniZ
### os.dog integration: @osdog
###
####################################################################################
cd `dirname $0`

PROFILE="$1"
[[ -z "$PROFILE" || ! -f "$PROFILE" ]] && echo -e "${RED}Usage: $0 <profile.json>${WHITE}" && exit 1

. ./profile.sh
load_profile

LOG="/var/log/osdog/miners/miniz.log"

# Build command
batch="./miniZ"
[[ -n "$ALGO" ]] && batch+=" --par=$ALGO"
[[ -n "$PASS" ]] && batch+=" -p $PASS"
[[ -n "$TEMPLATE" ]] && batch+=" -u $TEMPLATE"
[[ -n "$POOL" ]] && batch+=" -l $POOL"
batch+=" --telemetry=$API_PORT --log-file=$LOG"

echo "> Starting miniZ: $batch"

unbuffer $batch "${extra[@]}" 2>&1 | tee $LOG
