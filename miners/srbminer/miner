#!/bin/bash
####################################################################################
###
### SRBMiner-Multi
### os.dog integration: @osdog
###
####################################################################################
cd `dirname $0`

PROFILE="$1"
[[ -z "$PROFILE" || ! -f "$PROFILE" ]] && echo -e "${RED}Usage: $0 <profile.json>${WHITE}" && exit 1

. ./profile.sh
load_profile

LOG="/var/log/osdog/miners/srbminer.log"

# Build command
batch="./SRBMiner-MULTI"
[[ -n "$ALGO" ]] && batch+=" --algorithm $ALGO"
[[ -n "$POOL" ]] && batch+=" --pool $POOL"
[[ -n "$TEMPLATE" ]] && batch+=" --wallet $TEMPLATE"
[[ -n "$PASS" ]] && batch+=" --password $PASS"
batch+=" --api-enable --api-port $API_PORT"

echo "> Starting SRBMiner-Multi: $batch"

unbuffer $batch "${extra[@]}" 2>&1 | tee $LOG
